{
  "name": "auth-service",
  "version": "1.0.0",
  "private": true,
  "description": "Authentication service: credentials, devices, sessions and JWT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/main.js",
    "keys:generate": "node --env-file-if-exists=.env --import tsx src/generate_keys.ts",
    "seed": "node --env-file=.env --import tsx src/seed.ts",
    "seed:prod": "node --env-file=.env dist/seed.js",
    "oauth-client:create": "node --env-file=.env --import tsx src/create_oauth_client.ts",
    "test": "node --env-file=.env --import tsx --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "typecheck": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "mongoose": "^7.8.12",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/swagger-ui-express": "^4.1.8",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
