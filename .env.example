PORT=8081
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=auth_service

# Optional: public DNS for mongodb+srv:// when the local resolver cannot answer SRV lookups
DNS_SERVERS=8.8.8.8,1.1.1.1

USER_SERVICE_URL=http://localhost:8080

# RS256 signing key. Create it once with `npm run keys:generate` (never commit it).
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_ISSUER=auth-service
JWT_AUDIENCE=ms-api
ACCESS_TOKEN_TTL_SECONDS=900
CLIENT_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# Used by `npm run seed` (first-time setup): sets the password login of the SUPER_ADMIN user
# created by user-service (SUPER_ADMIN_EMAIL must match). Change the password outside local dev.
SUPER_ADMIN_EMAIL=superadmin@gmail.com
SUPER_ADMIN_PASSWORD=123456789

NOTIFICATION_SERVICE_URL=http://localhost:8082
# Frontend page that reads ?token= and calls POST /api/auth/verify-email
VERIFY_EMAIL_URL=http://localhost:3000/verify-email
EMAIL_VERIFICATION_TTL_HOURS=24

# Browser origins allowed to call this API (comma separated). Empty = no CORS.
CORS_ORIGINS=
# Set when running behind a reverse proxy / load balancer (true, number of hops, or a subnet).
TRUST_PROXY=false
# Login / register / token endpoint limits. Keep enabled outside tests.
RATE_LIMIT_ENABLED=true

# audit-service (optional). Empty = auditing disabled.
AUDIT_SERVICE_URL=
